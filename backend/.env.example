# --- Server ---
PORT=8787
HOST=0.0.0.0
DB_PATH=./data/calls.db

# --- Call provider: "mock" (no keys needed, simulated calls) or "retell" ---
CALL_PROVIDER=mock

# Secret embedded in the webhook URL: /webhooks/retell/<WEBHOOK_SECRET>
# Generate one with: openssl rand -hex 24
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Which destination country prefixes the backend will dial (comma separated)
ALLOWED_COUNTRY_PREFIXES=+49,+90,+44,+1

# --- Retell AI (required when CALL_PROVIDER=retell) — https://dashboard.retellai.com ---
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=
# Optional per-language agents (fall back to RETELL_AGENT_ID)
RETELL_AGENT_ID_DE=
RETELL_AGENT_ID_EN=
RETELL_AGENT_ID_TR=

# --- Anthropic (optional): user-facing call reports in the user's language ---
ANTHROPIC_API_KEY=
