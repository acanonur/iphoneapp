# Yaver backend — settings. Copy this file to ".env" and fill in what you need.
# With nothing filled in, the server runs in simulation mode: the whole app
# works, but no real phone call is made.
#
# A line that starts with # is switched off. To use such a setting, delete the
# "# " at the start of its line.

# --- Server ---
# Where the server listens and keeps its data. The values shown are the ones it
# uses anyway; a hosting service sets its own (leave these switched off there).
# PORT=8787
# HOST=0.0.0.0
# DB_PATH=./data/calls.db

# --- Calls: "mock" (simulated, no keys needed) or "retell" (real phone calls) ---
CALL_PROVIDER=mock

# Speed of simulated calls: 1 = real time, 0.2 = five times faster.
MOCK_PACE=1

# The server's window says what happens in plain sentences. Set this to true to
# also see a technical line for every request (for troubleshooting).
# LOG_REQUESTS=false

# --- Who may use this server ---
# The app has to present an access key as soon as real calls, a paid model or a
# public address are involved. The key is made up on first start, stored in the
# database and shown when the server starts (and inside the QR code). There is
# normally no reason to choose it yourself; if you do, it has to be long (at
# least 20 characters) — a short one can be guessed.
# API_KEY=
# REQUIRE_KEY=auto        # auto | always | never

# --- Reaching the server from outside your home network ---
# Either run "npm run start:public" (opens a free Cloudflare tunnel; needs
# "brew install cloudflared"), or host the server somewhere and put its
# address here, e.g. https://yaver.example.com
# PUBLIC_BASE_URL=

# --- Limits on real calls ---
# Which countries may be called (comma separated, international prefixes)
ALLOWED_COUNTRY_PREFIXES=+49,+90,+44,+1
# Inside those countries the server still refuses premium-rate, televoting,
# directory-enquiry and emergency numbers, and the Caribbean and Pacific places
# that share "+1" with the US and Canada. To change that list, set your own
# (comma separated; empty = refuse nothing):
# BLOCKED_NUMBER_PREFIXES=+49900,+49137,+49118,+4919,+90900,+449,+4470,+1900,+1976
# Real calls allowed per 24 hours (0 = no limit) and the longest a call may run
MAX_CALLS_PER_DAY=20
MAX_CALL_MINUTES=10

# --- Retell AI (needed when CALL_PROVIDER=retell) — https://dashboard.retellai.com ---
# Put the API key here, then run:  npm run retell:setup
# The script creates the agents and fills in the ids below.
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=
RETELL_INBOUND_AGENT_ID=
# Optional: a specific voice, and separate agents per language
# RETELL_VOICE_ID=
# RETELL_AGENT_ID_DE=
# RETELL_AGENT_ID_EN=
# RETELL_AGENT_ID_TR=
# Leave these on unless a call fails because of them (see docs/real-calls.md)
# RETELL_VERIFY_SIGNATURE=true
# RETELL_SEND_OVERRIDES=true
# RETELL_DELETE_AFTER_CALL=true

# --- Anthropic (optional): reports written by Claude; letters, messages, forms ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
