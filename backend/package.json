{
  "name": "yaver-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Backend for Yaver, the AI phone secretary: places and answers phone calls through a voice provider, reports back in the user's language, and handles letters, messages and forms.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "start:public": "TUNNEL=true tsx --env-file-if-exists=.env src/index.ts",
    "retell:setup": "tsx --env-file-if-exists=.env scripts/retell-setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "fastify": "^5.12.8",
    "qrcode-terminal": "^0.12.0",
    "retell-sdk": "^6.2.21"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
