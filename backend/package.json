{
  "name": "ai-secretary-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for the AI phone secretary iPhone app: places AI voice calls via a telephony provider and reports results back.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
