# Copy to .env and adjust. Every value here has a working default.

PORT=8788
HOST=0.0.0.0

# SQLite file. Keep it on persistent storage and back it up — this is all of
# your household's data.
DB_PATH=./data/ortak.db

# Browser origins allowed to call the API. The phone apps do not need this;
# it matters for local development and any web client.
CORS_ORIGINS=*

# When set, creating or joining a space also requires this secret. Worth setting
# if the server is reachable from the public internet.
# SIGNUP_SECRET=some-long-random-string

# Largest accepted WhatsApp export, in bytes (default 25 MB).
MAX_IMPORT_BYTES=26214400

# Set to false to stop the server making outbound requests for link previews.
LINK_PREVIEWS=true

LOG_LEVEL=info
