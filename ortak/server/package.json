{
  "name": "ortak-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sync server for Ortak: shared calendar, notes, lists, chat archive and trip expense splitting for a two-person household.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
