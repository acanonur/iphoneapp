{
  "expo": {
    "name": "Ortak",
    "slug": "ortak",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ortak",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ortak.app",
      "infoPlist": {
        "NSCalendarsFullAccessUsageDescription": "Ortak writes your shared plans into the calendar you choose, so they show up in Apple Calendar and any Google account on this phone.",
        "NSCalendarsUsageDescription": "Ortak writes your shared plans into the calendar you choose.",
        "NSRemindersFullAccessUsageDescription": "Ortak can add shared to-dos to Reminders."
      }
    },
    "android": {
      "package": "com.ortak.app",
      "adaptiveIcon": { "backgroundColor": "#151821" },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "intentFilters": [
        {
          "action": "android.intent.action.SEND",
          "category": ["android.intent.category.DEFAULT"],
          "data": [{ "mimeType": "text/plain" }]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "Ortak writes your shared plans into the calendar you choose."
        }
      ],
      [
        "expo-document-picker",
        { "iCloudContainerEnvironment": "Production" }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
